# Names only. Real values live in Vercel env (Production/Preview, mark Sensitive) and a local .env (gitignored).
# Full catalogue: docs/spec/01-architecture.md section 5.

# Payload auth secret, 32+ random chars (openssl rand -hex 32)
PAYLOAD_SECRET=
# Postgres connection string (pooled URL in production)
DATABASE_URI=
# Direct (unpooled) connection used by `payload migrate` in production/preview
DATABASE_URI_UNPOOLED=
# "true" enables Payload push mode on a throwaway LOCAL database only
PAYLOAD_PUSH=
# Canonical origin, no trailing slash (e.g. https://stumpnote.com)
NEXT_PUBLIC_SERVER_URL=
# Unused (reserved): Live Preview authenticates with the editor session, see decisions D-43
PREVIEW_SECRET=
# Vercel Blob token; unset locally = filesystem media storage
BLOB_READ_WRITE_TOKEN=
# Password reset / invite email (optional; unset = Payload logs a warning, sends nothing)
RESEND_API_KEY=
EMAIL_FROM=
# Web analytics provider (D-06): none | posthog | plausible | nouance-plugin
WEB_ANALYTICS_PROVIDER=
# Public project token (safe in the browser) and host, only if PostHog is chosen
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-only PostHog query access (Query Read scope)
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=
# Only if Plausible is chosen
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=
PLAUSIBLE_API_HOST=
# fixtures (default, synthetic data) | live
ANALYTICS_MODE=
# Read-only role URL for the StumpNote analytics schema (production only)
STUMPNOTE_ANALYTICS_DATABASE_URL=
# Phase 2 (RevenueCat overview metrics, read-only)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
# "1" blocks publishing a legal page that still has placeholders
LEGAL_STRICT=
# "1" enables experimental route transitions
NEXT_PUBLIC_FLAG_VIEW_TRANSITIONS=
# Optional PEM CA bundle for verifying the Supabase pooler TLS chain (use \n for newlines); TLS is never unverified
STUMPNOTE_ANALYTICS_CA_CERT=
# Local test fixtures only (pnpm analytics:users, admin.spec.ts); never set in Vercel
TEST_ADMIN_PASSWORD=
TEST_EDITOR_PASSWORD=
TEST_VIEWER_PASSWORD=
TEST_THROTTLE_PASSWORD=
# "1" runs tests/playwright/admin.spec.ts (needs the fixture users above)
ADMIN_FIXTURE=
