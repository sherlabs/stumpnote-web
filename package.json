{
  "name": "stumpnote-web",
  "version": "0.1.0",
  "description": "StumpNote marketing site and Payload CMS admin",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "ci": "payload migrate && pnpm build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm payload migrate",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "secrets": "bash scripts/check-secrets.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm secrets && pnpm audit --prod --audit-level=high",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "seed:dry": "cross-env SEED_DRY_RUN=1 NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "size": "node scripts/size-check.mjs",
    "test:lh": "node scripts/lighthouse.mjs",
    "seed:delete": "cross-env SEED_DELETE=1 NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "import:legal": "tsx scripts/import-legal.ts",
    "legal:bundle": "tsx scripts/import-legal.ts --bundle",
    "legal:fixture": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/legal-fixture.ts",
    "test:links": "node scripts/check-links.mjs",
    "analytics:fixtures": "tsx src/analytics/fixtures/generate-fixtures.ts",
    "analytics:users": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/analytics-fixture.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "graphql": "^16.8.2",
    "gsap": "~3.15.0",
    "lenis": "~1.3.26",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "posthog-js": "^1.435.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.6",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "undici": ">=7.29.1",
      "esbuild": ">=0.25.0",
      "dompurify": ">=3.4.16"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
