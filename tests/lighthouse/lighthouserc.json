{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/features",
        "http://localhost:3101/features/journal",
        "http://localhost:3101/players",
        "http://localhost:3101/captains",
        "http://localhost:3101/coaches",
        "http://localhost:3101/parents",
        "http://localhost:3101/pricing",
        "http://localhost:3101/security",
        "http://localhost:3101/join",
        "http://localhost:3101/support",
        "http://localhost:3101/privacy",
        "http://localhost:3101/terms",
        "http://localhost:3101/legal",
        "http://localhost:3101/blog"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "pnpm exec next start -p 3101",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3101/(privacy|terms|blog)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.65
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 150
              }
            ],
            "interactive": [
              "error",
              {
                "maxNumericValue": 3500
              }
            ],
            "font-display": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3101/(?!(privacy|terms|blog)$)",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 150
              }
            ],
            "interactive": [
              "error",
              {
                "maxNumericValue": 3500
              }
            ],
            "font-display": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ],
      "_comment": "/privacy and /terms are noindex while in notice mode, /blog while empty: Lighthouse scores that 0.69 on SEO by design (is-crawlable). They are gated at 0.65 so the other seven SEO audits must still pass; once a page is published it falls back to the 0.95 rule by moving it out of the first pattern."
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
