{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/features",
        "http://localhost:3101/features/journal",
        "http://localhost:3101/players",
        "http://localhost:3101/parents",
        "http://localhost:3101/pricing",
        "http://localhost:3101/security",
        "http://localhost:3101/join",
        "http://localhost:3101/support"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "pnpm exec next start -p 3101",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "interactive": [
          "error",
          {
            "maxNumericValue": 3500
          }
        ],
        "font-display": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
